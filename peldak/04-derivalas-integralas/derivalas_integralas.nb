(* Content-type: application/vnd.wolfram.mathematica *)
Notebook[{
Cell["Deriv\:00e1l\:00e1s \:00e9s integr\:00e1l\:00e1s", "Title"],

Cell["\:00d6n\:00e1ll\:00f3 eszk\:00f6zbemutat\:00f3. Ments saj\:00e1t m\:00e1solatot, majd a k\:00f3dcell\:00e1kat fel\:00fclr\:0151l lefel\:00e9, Shift+Enterrel futtasd. Az elv\:00e1rt eredm\:00e9nyek a mappa README-j\:00e9ben szerepelnek.", "Text"],

Cell["Az x val\:00f3s v\:00e1ltoz\:00f3; a tizedes 0.5 helyett egzakt 1/2 szerepel.", "Text"],

Cell[BoxData[RowBox[{"ClearAll", "[", "x", ",", " ", "f", ",", " ", "g", ",", " ", "primitivF", ",", " ", "primitivG", ",", " ", "integralF", ",", " ", "integralG", "]", ";", " ", "f", " ", "=", " ", "x", "^", "3", " ", "+", " ", "3", "*", "x", "^", "2", " ", "-", " ", "2", ";", " ", "g", " ", "=", " ", "Exp", "[", "-", "x", "/", "2", "]", "*", "Sin", "[", "x", "]", ";"}]], "Input"],

Cell["Deriv\:00e1ltak x szerint. Az f deriv\:00e1ltja 3*x^2+6*x.", "Text"],

Cell[BoxData[RowBox[{"{", "D", "[", "f", ",", " ", "x", "]", ",", " ", "D", "[", "g", ",", " ", "x", "]", "}"}]], "Input"],

Cell["Hat\:00e1rozatlan integr\:00e1l\:00e1s: egy-egy primit\:00edv f\:00fcggv\:00e9nyt kapunk. A teljes f\:00fcggv\:00e9nycsal\:00e1dhoz tetsz\:0151leges +C adhat\:00f3.", "Text"],

Cell[BoxData[RowBox[{"primitivF", " ", "=", " ", "Integrate", "[", "f", ",", " ", "x", "]", ";", " ", "primitivG", " ", "=", " ", "Integrate", "[", "g", ",", " ", "x", "]", ";", " ", "{", "primitivF", ",", " ", "primitivG", "}"}]], "Input"],

Cell["Visszaderiv\:00e1l\:00e1ssal ellen\:0151rz\:00fcnk. Elv\:00e1rt marad\:00e9kok: {0, 0}.", "Text"],

Cell[BoxData[RowBox[{"Simplify", "[", "{", "D", "[", "primitivF", ",", " ", "x", "]", " ", "-", " ", "f", ",", " ", "D", "[", "primitivG", ",", " ", "x", "]", " ", "-", " ", "g", "}", "]"}]], "Input"],

Cell["Hat\:00e1rozott integr\:00e1l\:00e1s 0 \:00e9s 1 k\:00f6z\:00f6tt: itt az als\:00f3 \:00e9s fels\:0151 hat\:00e1r is a parancs r\:00e9sze. Az f integr\:00e1lja -3/4.", "Text"],

Cell[BoxData[RowBox[{"integralF", " ", "=", " ", "Integrate", "[", "f", ",", " ", "{", "x", ",", " ", "0", ",", " ", "1", "}", "]", ";", " ", "integralG", " ", "=", " ", "Integrate", "[", "g", ",", " ", "{", "x", ",", " ", "0", ",", " ", "1", "}", "]", ";", " ", "{", "integralF", ",", " ", "integralG", "}"}]], "Input"],

Cell["Numerikus ki\:00e9rt\:00e9kel\:00e9s: -0.75 \:00e9s k\:00f6r\:00fclbel\:00fcl 0.333680888164203.", "Text"],

Cell[BoxData[RowBox[{"N", "[", "{", "integralF", ",", " ", "integralG", "}", ",", " ", "15", "]"}]], "Input"],

Cell["A primit\:00edv f\:00fcggv\:00e9ny hat\:00e1r\:00e9rt\:00e9keinek k\:00fcl\:00f6nbs\:00e9g\:00e9t is \:00f6sszevetj\:00fck az integr\:00e1llal. Elv\:00e1rt marad\:00e9kok: {0, 0}.", "Text"],

Cell[BoxData[RowBox[{"Simplify", "[", "{", "(", "primitivF", " ", "/.", " ", "x", " ", "->", " ", "1", ")", " ", "-", " ", "(", "primitivF", " ", "/.", " ", "x", " ", "->", " ", "0", ")", " ", "-", " ", "integralF", ",", " ", "(", "primitivG", " ", "/.", " ", "x", " ", "->", " ", "1", ")", " ", "-", " ", "(", "primitivG", " ", "/.", " ", "x", " ", "->", " ", "0", ")", " ", "-", " ", "integralG", "}", "]"}]], "Input"]
}, StyleDefinitions -> "Default.nb", WindowTitle -> "Deriv\:00e1l\:00e1s \:00e9s integr\:00e1l\:00e1s"]
